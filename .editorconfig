root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{c,h}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.v]
indent_size = 2

[*.lean]
indent_size = 2

[*.sh]
indent_size = 4

[{*.cmake,CMakeLists.txt,*.cmake.in}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.toml]
indent_size = 4

[Makefile]
indent_style = tab
