#!/bin/sh
set -eu
remote="$1"
check="$(git rev-parse --show-toplevel)/script/check_commit.sh"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
    esac
    "$check" "$local_sha" --not --remotes="$remote" || status=1
done
exit "$status"
