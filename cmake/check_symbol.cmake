file(STRINGS ${SOURCE_DIR}/cmake/symbol.txt listed)
list(SORT listed)

file(GLOB header ${SOURCE_DIR}/include/diana/*.h)
set(declared)
foreach(path IN LISTS header)
    file(READ ${path} text)
    string(REGEX MATCHALL "[ *]diana_[a-z0-9_]+\\(" match "${text}")
    foreach(name IN LISTS match)
        string(REGEX REPLACE "^[ *](.*)\\($" "\\1" name "${name}")
        list(APPEND declared ${name})
    endforeach()
endforeach()
list(REMOVE_DUPLICATES declared)
list(SORT declared)
if(NOT declared STREQUAL listed)
    message(FATAL_ERROR "cmake/symbol.txt (${listed}) differs from the functions declared in "
                        "include/diana (${declared})")
endif()

if(DEFINED LIBRARY)
    if(APPLE)
        execute_process(COMMAND ${NM} -g ${LIBRARY} OUTPUT_VARIABLE out RESULT_VARIABLE rc)
    else()
        execute_process(COMMAND ${NM} -D --defined-only ${LIBRARY} OUTPUT_VARIABLE out
                        RESULT_VARIABLE rc)
    endif()
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${NM} failed on ${LIBRARY}")
    endif()
    string(REGEX MATCHALL "[^\n]+" line "${out}")
    set(exported)
    foreach(entry IN LISTS line)
        if(entry MATCHES "^[0-9a-fA-F]+ [A-TV-Z] _?(diana_[A-Za-z0-9_]+)$")
            list(APPEND exported ${CMAKE_MATCH_1})
        endif()
    endforeach()
    list(SORT exported)
    if(NOT exported STREQUAL listed)
        message(FATAL_ERROR "${LIBRARY} exports (${exported}), cmake/symbol.txt lists (${listed})")
    endif()
endif()
