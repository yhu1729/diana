from collections.abc import Buffer
from typing import Final

OK: Final[int]
CONTINUE: Final[int]
ERR_ARG: Final[int]
ERR_BRACKET: Final[int]
ERR_MAXITER: Final[int]
ERR_SINGULAR: Final[int]

class BracketError(ValueError): ...
class SingularError(ValueError): ...

class Bisection:
    @property
    def a(self) -> float: ...
    @property
    def b(self) -> float: ...
    @property
    def fa(self) -> float: ...
    @property
    def fb(self) -> float: ...
    @property
    def x(self) -> float: ...
    @property
    def tol(self) -> float: ...
    @property
    def iter(self) -> int: ...
    @property
    def max_iter(self) -> int: ...
    @property
    def status(self) -> int: ...
    def __init__(
        self, a: float, b: float, fa: float, fb: float, tol: float = 0.0, max_iter: int = 2100
    ) -> None: ...
    def step(self, fx: float, /) -> int: ...
    def result(self) -> tuple[float, float]: ...

class Newton:
    @property
    def x(self) -> float: ...
    @property
    def dx(self) -> float: ...
    @property
    def tol(self) -> float: ...
    @property
    def iter(self) -> int: ...
    @property
    def max_iter(self) -> int: ...
    @property
    def status(self) -> int: ...
    def __init__(self, x0: float, tol: float, max_iter: int = 100) -> None: ...
    def step(self, fx: float, dfx: float, /) -> int: ...
    def result(self) -> tuple[float, float]: ...

def version() -> str: ...
def status_str(status: int, /) -> str: ...
def trapezoidal(y: Buffer, h: float) -> float: ...
def simpson(y: Buffer, h: float) -> float: ...
def cholesky(a: Buffer, out: Buffer) -> None: ...
def forward_substitution(lower: Buffer, b: Buffer, out: Buffer) -> None: ...
def back_substitution(lower: Buffer, b: Buffer, out: Buffer) -> None: ...
def euler_step(y: Buffer, f: Buffer, h: float, out: Buffer) -> None: ...
def rk4_stage(y: Buffer, k: Buffer, h: float, stage: int, out: Buffer) -> None: ...
def rk4_step(
    y: Buffer, k1: Buffer, k2: Buffer, k3: Buffer, k4: Buffer, h: float, out: Buffer
) -> None: ...
